# Copy to .env for local (non-docker) runs.

# Quick start, zero setup:
#DATABASE_URL=sqlite:///./setu.db

# Or, against docker-compose's Postgres:
DATABASE_URL=postgresql://postgres:keerthi727@localhost:5432/postgres

# Leave empty to disable auth locally. Set a real value in production.
API_KEY=

UNSETTLED_THRESHOLD_HOURS=24

# Leave unset to use real wall-clock time. Set to an ISO timestamp to get
# reproducible reconciliation results against the static sample dataset,
# e.g. 2026-02-01T00:00:00+00:00
RECONCILIATION_REFERENCE_TIME=

APP_ENV=development
LOG_LEVEL=INFO
