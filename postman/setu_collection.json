{
  "info": {
    "name": "FastPay Payment Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ingestion, transaction retrieval, and reconciliation reporting endpoints."
  },
  "variable": [
    { "key": "base_url", "value": "https://setu-payment-service-ru8i.onrender.com" },
    { "key": "api_key", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
      }
    },
    {
      "name": "Ingest single event",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-API-Key", "value": "{{api_key}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_id\": \"demo-evt-1\",\n  \"event_type\": \"payment_initiated\",\n  \"transaction_id\": \"demo-txn-1\",\n  \"merchant_id\": \"merchant_1\",\n  \"merchant_name\": \"UrbanMart\",\n  \"amount\": 1500.00,\n  \"currency\": \"INR\",\n  \"timestamp\": \"2026-01-10T10:00:00+00:00\"\n}"
        },
        "url": { "raw": "{{base_url}}/events", "host": ["{{base_url}}"], "path": ["events"] }
      }
    },
    {
      "name": "Ingest same event again (idempotency check)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-API-Key", "value": "{{api_key}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_id\": \"demo-evt-1\",\n  \"event_type\": \"payment_initiated\",\n  \"transaction_id\": \"demo-txn-1\",\n  \"merchant_id\": \"merchant_1\",\n  \"merchant_name\": \"UrbanMart\",\n  \"amount\": 1500.00,\n  \"currency\": \"INR\",\n  \"timestamp\": \"2026-01-10T10:00:00+00:00\"\n}"
        },
        "url": { "raw": "{{base_url}}/events", "host": ["{{base_url}}"], "path": ["events"] },
        "description": "Expect status: duplicate_ignored on the second call."
      }
    },
    {
      "name": "Follow-up: payment processed",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-API-Key", "value": "{{api_key}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_id\": \"demo-evt-2\",\n  \"event_type\": \"payment_processed\",\n  \"transaction_id\": \"demo-txn-1\",\n  \"merchant_id\": \"merchant_1\",\n  \"merchant_name\": \"UrbanMart\",\n  \"amount\": 1500.00,\n  \"currency\": \"INR\",\n  \"timestamp\": \"2026-01-10T10:05:00+00:00\"\n}"
        },
        "url": { "raw": "{{base_url}}/events", "host": ["{{base_url}}"], "path": ["events"] }
      }
    },
    {
      "name": "Follow-up: settled",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-API-Key", "value": "{{api_key}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_id\": \"demo-evt-3\",\n  \"event_type\": \"settled\",\n  \"transaction_id\": \"demo-txn-1\",\n  \"merchant_id\": \"merchant_1\",\n  \"merchant_name\": \"UrbanMart\",\n  \"amount\": 1500.00,\n  \"currency\": \"INR\",\n  \"timestamp\": \"2026-01-10T10:15:00+00:00\"\n}"
        },
        "url": { "raw": "{{base_url}}/events", "host": ["{{base_url}}"], "path": ["events"] }
      }
    },
    {
      "name": "Batch ingest",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-API-Key", "value": "{{api_key}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "[\n  {\n    \"event_id\": \"demo-evt-batch-1\",\n    \"event_type\": \"payment_initiated\",\n    \"transaction_id\": \"demo-txn-batch-1\",\n    \"merchant_id\": \"merchant_2\",\n    \"merchant_name\": \"FreshBasket\",\n    \"amount\": 500,\n    \"currency\": \"INR\",\n    \"timestamp\": \"2026-01-11T09:00:00+00:00\"\n  }\n]"
        },
        "url": { "raw": "{{base_url}}/events/batch", "host": ["{{base_url}}"], "path": ["events", "batch"] }
      }
    },
    {
      "name": "List transactions (filtered + paginated)",
      "request": {
        "method": "GET",
        "header": [ { "key": "X-API-Key", "value": "{{api_key}}" } ],
        "url": {
          "raw": "{{base_url}}/transactions?merchant_id=merchant_1&page=1&page_size=25&sort_by=last_event_at&sort_order=desc",
          "host": ["{{base_url}}"],
          "path": ["transactions"],
          "query": [
            { "key": "merchant_id", "value": "merchant_1" },
            { "key": "status", "value": "", "disabled": true },
            { "key": "date_from", "value": "", "disabled": true },
            { "key": "date_to", "value": "", "disabled": true },
            { "key": "page", "value": "1" },
            { "key": "page_size", "value": "25" },
            { "key": "sort_by", "value": "last_event_at" },
            { "key": "sort_order", "value": "desc" }
          ]
        }
      }
    },
    {
      "name": "Get transaction detail",
      "request": {
        "method": "GET",
        "header": [ { "key": "X-API-Key", "value": "{{api_key}}" } ],
        "url": {
          "raw": "{{base_url}}/transactions/demo-txn-1",
          "host": ["{{base_url}}"],
          "path": ["transactions", "demo-txn-1"]
        }
      }
    },
    {
      "name": "Reconciliation summary (by merchant)",
      "request": {
        "method": "GET",
        "header": [ { "key": "X-API-Key", "value": "{{api_key}}" } ],
        "url": {
          "raw": "{{base_url}}/reconciliation/summary?group_by=merchant",
          "host": ["{{base_url}}"],
          "path": ["reconciliation", "summary"],
          "query": [ { "key": "group_by", "value": "merchant" } ]
        }
      }
    },
    {
      "name": "Reconciliation summary (by date)",
      "request": {
        "method": "GET",
        "header": [ { "key": "X-API-Key", "value": "{{api_key}}" } ],
        "url": {
          "raw": "{{base_url}}/reconciliation/summary?group_by=date",
          "host": ["{{base_url}}"],
          "path": ["reconciliation", "summary"],
          "query": [ { "key": "group_by", "value": "date" } ]
        }
      }
    },
    {
      "name": "Reconciliation summary (by status)",
      "request": {
        "method": "GET",
        "header": [ { "key": "X-API-Key", "value": "{{api_key}}" } ],
        "url": {
          "raw": "{{base_url}}/reconciliation/summary?group_by=status",
          "host": ["{{base_url}}"],
          "path": ["reconciliation", "summary"],
          "query": [ { "key": "group_by", "value": "status" } ]
        }
      }
    },
    {
      "name": "Reconciliation discrepancies",
      "request": {
        "method": "GET",
        "header": [ { "key": "X-API-Key", "value": "{{api_key}}" } ],
        "url": {
          "raw": "{{base_url}}/reconciliation/discrepancies?page=1&page_size=25",
          "host": ["{{base_url}}"],
          "path": ["reconciliation", "discrepancies"],
          "query": [
            { "key": "merchant_id", "value": "", "disabled": true },
            { "key": "page", "value": "1" },
            { "key": "page_size", "value": "25" }
          ]
        }
      }
    }
  ]
}
